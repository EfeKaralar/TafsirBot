# ── LLM ───────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY is required regardless of provider — it serves dense embeddings.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic

# Model per role. The primary model writes answers; the fast model handles
# classification, query rewriting, chunk grading and citation verification.
# Defaults are in src/tafsirbot/settings.py — override only to pin or downgrade.
# MODEL_PRIMARY_ANTHROPIC=claude-sonnet-5
# MODEL_FAST_ANTHROPIC=claude-haiku-4-5-20251001
# MODEL_PRIMARY_OPENAI=gpt-4o
# MODEL_FAST_OPENAI=gpt-4o-mini

# ── Embeddings ────────────────────────────────────────────────────────────────
# Do not change this after the first upsert — mixing models breaks the collection.
# Vector dimensions and the token limit are DERIVED from this value
# (see EMBEDDING_SPECS in src/tafsirbot/settings.py); never set them separately.
EMBEDDING_MODEL=text-embedding-3-large
# SPARSE_MODEL=Qdrant/bm42-all-minilm-l6-v2-attentions

# ── Vector DB ─────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=tafsir
# Separate collection for Hadith corpus (Phase 3+). Set when hadith data is ingested.
QDRANT_HADITH_COLLECTION=hadith

# ── Postgres ──────────────────────────────────────────────────────────────────
# Docker container init settings and local app connection settings.
# When running Python scripts on your host machine, use POSTGRES_HOST=localhost.
# If a future app runs inside docker-compose, it should use POSTGRES_HOST=postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tafsir_bot
POSTGRES_USER=tafsirbot
POSTGRES_PASSWORD=tafsirbot_dev_password
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5

# ── Ingestion ─────────────────────────────────────────────────────────────────
# Path to sources/quran-json/dist/ relative to repo root
QURAN_JSON_DIST=sources/quran-json/dist

# ── API ───────────────────────────────────────────────────────────────────────
# Comma-separated. Must include the web dev server; SSE breaks without a match.
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Migrations ────────────────────────────────────────────────────────────────
# On in dev. Set to 0 in production, where a deploy step runs migrations —
# otherwise N uvicorn workers race on DDL.
TAFSIRBOT_RUN_MIGRATIONS=1
